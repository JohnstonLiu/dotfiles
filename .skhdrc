#i3 bindings for focus
ctrl + shift - j : yabai -m window --focus stack.next || yabai -m window --focus south
ctrl + shift - k : yabai -m window --focus stack.prev || yabai -m window --focus north
ctrl + shift - h : yabai -m window --focus west
ctrl + shift - l : yabai -m window --focus east

#various bindings
ctrl + shift - r : yabai -m space --rotate 90
ctrl + shift - e : yabai -m space --layout bsp
ctrl + shift - s : yabai -m space --layout stack
ctrl + shift - f : yabai -m window --toggle float

#swapping
ctrl + alt - h : yabai -m window --swap west
ctrl + alt - j : yabai -m window --swap north
ctrl + alt - k : yabai -m window --swap south
ctrl + alt - l : yabai -m window --swap east

# Increase window size.
shift + alt - a : yabai -m window --resize left:-20:0
shift + alt - s : yabai -m window --resize bottom:0:20
shift + alt - w : yabai -m window --resize top:0:-20
shift + alt - d : yabai -m window --resize right:20:0

# Decrease window size.
shift + cmd - a : yabai -m window --resize left:20:0
shift + cmd - s : yabai -m window --resize bottom:0:-20
shift + cmd - w : yabai -m window --resize top:0:20
shift + cmd - d : yabai -m window --resize right:-20:0

#focus desktops (space 1 is sacrificial, keys map n -> n+1)
ctrl - 1 : yabai -m space --focus 2
ctrl - 2 : yabai -m space --focus 3
ctrl - 3 : yabai -m space --focus 4
ctrl - 4 : yabai -m space --focus 5
ctrl - 5 : yabai -m space --focus 6
ctrl - 6 : yabai -m space --focus 7
ctrl - 7 : yabai -m space --focus 8
ctrl - 8 : yabai -m space --focus 9
ctrl - 9 : yabai -m space --focus 10

#moving windows (space 1 is sacrificial, keys map n -> n+1)
ctrl + shift - 1 : yabai -m window --space 2
ctrl + shift - 2 : yabai -m window --space 3
ctrl + shift - 3 : yabai -m window --space 4
ctrl + shift - 4 : yabai -m window --space 5
ctrl + shift - 5 : yabai -m window --space 6
ctrl + shift - 6 : yabai -m window --space 7
ctrl + shift - 7 : yabai -m window --space 8
ctrl + shift - 8 : yabai -m window --space 9
ctrl + shift - 9 : yabai -m window --space 10
